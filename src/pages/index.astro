---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MrDolar — Conversor BCV</title>
    <meta name="description" content="Conversor de dólares y euros a bolívares según tasa BCV" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <div class="card">
        <h1>MrDolar</h1>
        <p class="subtitle">Conversor BCV</p>

        <div class="tabs" role="tablist">
          <button class="tab active" data-currency="USD" role="tab">$ USD</button>
          <button class="tab" data-currency="EUR" role="tab">€ EUR</button>
        </div>

        <div class="rate-bar" id="rate-primary">
          <span class="rate-label">Tasa USD</span>
          <span>
            <span class="rate-value" id="rate-usd">—</span>
            <span class="rate-badge">BCV</span>
          </span>
        </div>

        <div class="rate-bar secondary" id="rate-secondary">
          <span class="rate-label">Tasa EUR</span>
          <span class="rate-value" id="rate-eur">—</span>
        </div>

        <div class="form-group">
          <label for="from-amount" id="from-label">Dólares (USD)</label>
          <div class="input-wrapper">
            <span class="currency-prefix" id="from-symbol">$</span>
            <input type="number" id="from-amount" placeholder="0.00" step="any" min="0" />
            <button class="paste-btn" id="paste-from" type="button" aria-label="Pegar" title="Pegar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
              </svg>
            </button>
          </div>
        </div>

        <button class="swap-btn" id="swap-btn" aria-label="Invertir">⇅</button>

        <div class="form-group">
          <label for="to-amount">Bolívares (Bs)</label>
          <div class="input-wrapper">
            <span class="currency-prefix">Bs</span>
            <input type="number" id="to-amount" placeholder="0.00" step="any" min="0" />
            <button class="paste-btn" id="paste-to" type="button" aria-label="Pegar" title="Pegar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
              </svg>
            </button>
          </div>
        </div>

        <div class="result-box" id="result">
          <span id="result-text">Ingresa un valor</span>
          <button class="copy-btn" id="copy-btn" type="button" aria-label="Copiar monto en Bs" title="Copiar monto en Bs">
            <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </button>
        </div>
      </div>
    </main>

    <script>
      const API_URL = "/api/tasa/public";
      const CACHE_KEY = "mrdolar_rates";
      const CACHE_TS_KEY = "mrdolar_rates_ts";

      const fromInput = document.getElementById("from-amount");
      const toInput = document.getElementById("to-amount");
      const pasteFromBtn = document.getElementById("paste-from");
      const pasteToBtn = document.getElementById("paste-to");
      const resultText = document.getElementById("result-text");
      const rateUsd = document.getElementById("rate-usd");
      const rateEur = document.getElementById("rate-eur");
      const copyBtn = document.getElementById("copy-btn");
      const tabs = document.querySelectorAll(".tab");
      const fromLabel = document.getElementById("from-label");
      const fromSymbol = document.getElementById("from-symbol");

      let rates = { usd: 0, eur: 0 };
      let selected = "USD";
      let activeSource = "from";
      let lastBsAmount = 0;

      function fmt(n) {
        return Number(n).toLocaleString("es-VE", {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });
      }

      function setResult(text, isError = false) {
        resultText.textContent = text;
        resultText.style.color = isError ? "var(--red)" : "#1a7a36";
      }

      function getRate() {
        return selected === "USD" ? rates.usd : rates.eur;
      }

      function convert() {
        const tasa = getRate();
        if (!tasa) return;

        if (activeSource === "from") {
          const val = parseFloat(fromInput.value);
          if (isNaN(val) || val <= 0) {
            toInput.value = "";
            setResult("Ingresa un valor");
            return;
          }
          const bs = val * tasa;
          lastBsAmount = bs;
          toInput.value = fmt(bs);
          const sym = selected === "USD" ? "$" : "€";
          setResult(`${sym} ${fmt(val)} = Bs ${fmt(bs)}`);
        } else {
          const val = parseFloat(toInput.value);
          if (isNaN(val) || val <= 0) {
            fromInput.value = "";
            setResult("Ingresa un valor");
            return;
          }
          lastBsAmount = val;
          const converted = val / tasa;
          fromInput.value = fmt(converted);
          const sym = selected === "USD" ? "$" : "€";
          setResult(`Bs ${fmt(val)} = ${sym} ${fmt(converted)}`);
        }
      }

      function onFromInput() {
        activeSource = "from";
        convert();
      }

      function onToInput() {
        activeSource = "to";
        convert();
      }

      function swap() {
        const fromVal = fromInput.value;
        const toVal = toInput.value;
        fromInput.value = toVal;
        toInput.value = fromVal;
        activeSource = activeSource === "from" ? "to" : "from";
        convert();
      }

      function parsePasteValue(text) {
        let t = text
          .trim()
          .replace(/[$€£]/g, "")
          .replace(/bs\.?\s*/gi, "")
          .replace(/\s/g, "");
        if (!t || !/^[\d.,]+$/.test(t)) return null;

        const dots = (t.match(/\./g) || []).length;
        const commas = (t.match(/,/g) || []).length;

        if (dots && commas) {
          t =
            t.lastIndexOf(".") > t.lastIndexOf(",")
              ? t.replace(/,/g, "")
              : t.replace(/\./g, "").replace(",", ".");
        } else if (commas) {
          t = t.replace(/,/g, ".");
        } else if (dots > 1) {
          t = t.replace(/\./g, "");
        }

        const num = parseFloat(t);
        return isNaN(num) ? null : num;
      }

      async function readClipboardValue() {
        try {
          const text = await navigator.clipboard.readText();
          return parsePasteValue(text);
        } catch {
          return null;
        }
      }

      async function handlePasteFrom() {
        const num = await readClipboardValue();
        if (num == null) return;
        activeSource = "from";
        fromInput.value = num;
        convert();
      }

      async function handlePasteTo() {
        const num = await readClipboardValue();
        if (num == null) return;
        activeSource = "to";
        toInput.value = num;
        convert();
      }

      function handleNativePaste(input, isTo) {
        return function (e) {
          const text = e.clipboardData ? e.clipboardData.getData("text") : "";
          const num = parsePasteValue(text);
          if (num == null) return;
          e.preventDefault();
          activeSource = isTo ? "to" : "from";
          input.value = num;
          convert();
        };
      }

      async function handleCopy() {
        if (!lastBsAmount) return;
        try {
          await navigator.clipboard.writeText(fmt(lastBsAmount));
          copyBtn.classList.add("copied");
          setTimeout(() => copyBtn.classList.remove("copied"), 1500);
        } catch {
          setResult("No se pudo copiar", true);
        }
      }

      function selectTab(currency) {
        selected = currency;
        tabs.forEach((t) => t.classList.toggle("active", t.dataset.currency === currency));

        const sym = currency === "USD" ? "$" : "€";
        fromSymbol.textContent = sym;
        fromLabel.textContent = currency === "USD" ? "Dólares (USD)" : "Euros (EUR)";

        const tasa = getRate();
        if (tasa) {
          rateUsd.textContent = `Bs ${fmt(rates.usd)}`;
          rateEur.textContent = `Bs ${fmt(rates.eur)}`;
          const primaryRate = document.getElementById("rate-primary");
          const secondaryRate = document.getElementById("rate-secondary");
          if (currency === "USD") {
            primaryRate.style.display = "flex";
            secondaryRate.style.display = "flex";
          } else {
            primaryRate.style.display = "flex";
            secondaryRate.style.display = "flex";
          }
          convert();
        }
      }

      function updateRatesUI() {
        rateUsd.textContent = rates.usd ? `Bs ${fmt(rates.usd)}` : "—";
        rateEur.textContent = rates.eur ? `Bs ${fmt(rates.eur)}` : "—";
      }

      async function fetchRates() {
        try {
          const res = await fetch(API_URL);
          if (!res.ok) throw new Error("Error al obtener tasas");
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          rates.usd = data.usd || 0;
          rates.eur = data.eur || 0;
          if (!rates.usd && !rates.eur) throw new Error("Tasas no disponibles");

          localStorage.setItem(CACHE_KEY, JSON.stringify(rates));
          localStorage.setItem(CACHE_TS_KEY, String(Date.now()));
          updateRatesUI();
          const tasa = getRate();
          if (tasa) convert();
          return true;
        } catch {
          return false;
        }
      }

      function loadCachedRates() {
        const raw = localStorage.getItem(CACHE_KEY);
        const ts = localStorage.getItem(CACHE_TS_KEY);
        if (raw && ts) {
          const age = Date.now() - Number(ts);
          if (age < 3_600_000) {
            rates = JSON.parse(raw);
            updateRatesUI();
            const tasa = getRate();
            if (tasa) convert();
            return true;
          }
        }
        return false;
      }

      async function init() {
        const hasCache = loadCachedRates();
        const ok = await fetchRates();
        if (!ok && !hasCache) {
          setResult("No se pudieron obtener las tasas", true);
          return;
        }
        if (!ok && hasCache) {
          setResult("Usando tasas guardadas", true);
        }
      }

      tabs.forEach((tab) =>
        tab.addEventListener("click", () => selectTab(tab.dataset.currency))
      );
      fromInput.addEventListener("input", onFromInput);
      toInput.addEventListener("input", onToInput);
      fromInput.addEventListener("paste", handleNativePaste(fromInput, false));
      toInput.addEventListener("paste", handleNativePaste(toInput, true));
      document.getElementById("swap-btn").addEventListener("click", swap);
      pasteFromBtn.addEventListener("click", handlePasteFrom);
      pasteToBtn.addEventListener("click", handlePasteTo);
      copyBtn.addEventListener("click", handleCopy);

      init();
    </script>
  </body>
</html>
