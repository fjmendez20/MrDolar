---
import "../styles/global.css";
import { RATES, DEFAULT_RATE_KEY } from "../lib/rates";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MrDolar — Conversor BCV</title>
    <meta
      name="description"
      content="Conversor de dólares, euros y USDT a bolívares según tasa BCV y mercado P2P de Binance"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <div class="card">
        <h1>MrDolar</h1>
        <p class="subtitle">Conversor BCV</p>

        <div class="tabs" role="tablist">
          {
            RATES.map((rate) => (
              <button
                class:list={["tab", { active: rate.key === DEFAULT_RATE_KEY }]}
                data-currency={rate.key}
                title={rate.title}
                type="button"
                role="tab"
              >
                {rate.tab}
              </button>
            ))
          }
        </div>

        {
          RATES.map((rate, i) => (
            <div
              class:list={["rate-bar", { active: rate.key === DEFAULT_RATE_KEY }]}
              data-currency={rate.key}
            >
              <span class="rate-label">{rate.rateLabel}</span>
              <span>
                <span class="rate-value" id={`rate-${rate.key}`}>—</span>
                {i === 0 && <span class="rate-badge">BCV</span>}
              </span>
            </div>
          ))
        }

        <div class="form-group">
          <label for="from-amount" id="from-label">{RATES[0].inputLabel}</label>
          <div class="input-wrapper">
            <span class="currency-prefix" id="from-symbol">{RATES[0].symbol}</span>
            <input type="number" id="from-amount" placeholder="0.00" step="any" min="0" />
            <button class="paste-btn" id="paste-from" type="button" aria-label="Pegar" title="Pegar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
              </svg>
            </button>
          </div>
        </div>

        <button class="swap-btn" id="swap-btn" aria-label="Invertir">⇅</button>

        <div class="form-group">
          <label for="to-amount">Bolívares (Bs)</label>
          <div class="input-wrapper">
            <span class="currency-prefix">Bs</span>
            <input type="number" id="to-amount" placeholder="0.00" step="any" min="0" />
            <button class="paste-btn" id="paste-to" type="button" aria-label="Pegar" title="Pegar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
              </svg>
            </button>
          </div>
        </div>

        <div class="result-box" id="result">
          <span id="result-text">Ingresa un valor</span>
          <button class="copy-btn" id="copy-btn" type="button" aria-label="Copiar monto en Bs" title="Copiar monto en Bs">
            <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </button>
        </div>
      </div>
    </main>

    <script>
      import { RATES, DEFAULT_RATE_KEY, findRate, emptyRates } from "../lib/rates";
      import { parsePasteValue } from "../lib/parse";

      const API_URL = "/api/tasa/public";
      const CACHE_KEY = "mrdolar_rates_v2";
      const CACHE_TS_KEY = "mrdolar_rates_ts";
      const CACHE_TTL = 600_000;

      const fromInput = document.getElementById("from-amount");
      const toInput = document.getElementById("to-amount");
      const pasteFromBtn = document.getElementById("paste-from");
      const pasteToBtn = document.getElementById("paste-to");
      const resultText = document.getElementById("result-text");
      const copyBtn = document.getElementById("copy-btn");
      const tabs = document.querySelectorAll(".tab");
      const rateBars = document.querySelectorAll(".rate-bar[data-currency]");
      const fromLabel = document.getElementById("from-label");
      const fromSymbol = document.getElementById("from-symbol");

      const rateValueEls = Object.fromEntries(
        RATES.map((rate) => [rate.key, document.getElementById(`rate-${rate.key}`)])
      );

      let rates = emptyRates();
      let selectedKey = DEFAULT_RATE_KEY;
      let activeSource = "from";
      let lastBsAmount = 0;

      function fmt(n) {
        return Number(n).toLocaleString("es-VE", {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });
      }

      function setResult(text, isError = false) {
        resultText.textContent = text;
        resultText.style.color = isError ? "var(--red)" : "#1a7a36";
      }

      function getRate() {
        return rates[selectedKey];
      }

      function getSymbol() {
        return findRate(selectedKey).symbol;
      }

      function hasAnyRate() {
        return RATES.some((rate) => rates[rate.key]);
      }

      function convert() {
        const tasa = getRate();
        if (!tasa) return;

        if (activeSource === "from") {
          const val = parseFloat(fromInput.value);
          if (isNaN(val) || val <= 0) {
            toInput.value = "";
            setResult("Ingresa un valor");
            return;
          }
          const bs = val * tasa;
          lastBsAmount = bs;
          toInput.value = fmt(bs);
          setResult(`${getSymbol()} ${fmt(val)} = Bs ${fmt(bs)}`);
        } else {
          const val = parseFloat(toInput.value);
          if (isNaN(val) || val <= 0) {
            fromInput.value = "";
            setResult("Ingresa un valor");
            return;
          }
          lastBsAmount = val;
          const converted = val / tasa;
          fromInput.value = fmt(converted);
          setResult(`Bs ${fmt(val)} = ${getSymbol()} ${fmt(converted)}`);
        }
      }

      function onFromInput() {
        activeSource = "from";
        convert();
      }

      function onToInput() {
        activeSource = "to";
        convert();
      }

      function swap() {
        const fromVal = fromInput.value;
        const toVal = toInput.value;
        fromInput.value = toVal;
        toInput.value = fromVal;
        activeSource = activeSource === "from" ? "to" : "from";
        convert();
      }

      async function readClipboardValue() {
        try {
          const text = await navigator.clipboard.readText();
          return parsePasteValue(text);
        } catch {
          return null;
        }
      }

      async function handlePasteFrom() {
        const num = await readClipboardValue();
        if (num == null) return;
        activeSource = "from";
        fromInput.value = num;
        convert();
      }

      async function handlePasteTo() {
        const num = await readClipboardValue();
        if (num == null) return;
        activeSource = "to";
        toInput.value = num;
        convert();
      }

      function handleNativePaste(input, isTo) {
        return function (e) {
          const text = e.clipboardData ? e.clipboardData.getData("text") : "";
          const num = parsePasteValue(text);
          if (num == null) return;
          e.preventDefault();
          activeSource = isTo ? "to" : "from";
          input.value = num;
          convert();
        };
      }

      async function handleCopy() {
        if (!lastBsAmount) return;
        try {
          await navigator.clipboard.writeText(fmt(lastBsAmount));
          copyBtn.classList.add("copied");
          setTimeout(() => copyBtn.classList.remove("copied"), 1500);
        } catch {
          setResult("No se pudo copiar", true);
        }
      }

      function selectTab(key) {
        selectedKey = key;
        const def = findRate(key);

        tabs.forEach((t) => t.classList.toggle("active", t.dataset.currency === key));
        rateBars.forEach((bar) =>
          bar.classList.toggle("active", bar.dataset.currency === key)
        );
        fromSymbol.textContent = def.symbol;
        fromLabel.textContent = def.inputLabel;

        if (!getRate()) {
          setResult("Tasa no disponible para esta moneda", true);
          return;
        }
        convert();
      }

      function updateRatesUI() {
        for (const rate of RATES) {
          const el = rateValueEls[rate.key];
          if (!el) continue;
          const value = rates[rate.key];
          el.textContent = value ? `Bs ${fmt(value)}` : "—";
        }
      }

      function applyRates(payload) {
        for (const rate of RATES) {
          const value = Number(payload?.[rate.key]);
          if (Number.isFinite(value) && value > 0) rates[rate.key] = value;
        }
      }

      function payloadHasRate(payload) {
        return RATES.some((rate) => {
          const value = Number(payload?.[rate.key]);
          return Number.isFinite(value) && value > 0;
        });
      }

      async function fetchRates() {
        try {
          const res = await fetch(API_URL);
          if (!res.ok) throw new Error("Error al obtener tasas");
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          if (!payloadHasRate(data)) throw new Error("Tasas no disponibles");

          applyRates(data);

          localStorage.setItem(CACHE_KEY, JSON.stringify(rates));
          localStorage.setItem(CACHE_TS_KEY, String(Date.now()));
          updateRatesUI();
          if (getRate()) convert();
          return true;
        } catch {
          return false;
        }
      }

      function readCachedRates() {
        const raw = localStorage.getItem(CACHE_KEY);
        if (!raw) return false;

        try {
          applyRates(JSON.parse(raw));
        } catch {
          return false;
        }
        if (!hasAnyRate()) return false;

        updateRatesUI();
        if (getRate()) convert();
        return true;
      }

      function cacheIsFresh() {
        const ts = localStorage.getItem(CACHE_TS_KEY);
        return !!ts && Date.now() - Number(ts) < CACHE_TTL;
      }

      async function init() {
        const hasCache = readCachedRates();
        const ok = await fetchRates();
        if (ok) return;
        if (!hasCache) {
          setResult("No se pudieron obtener las tasas", true);
          return;
        }
        setResult(
          cacheIsFresh()
            ? "No se pudieron actualizar las tasas"
            : "Usando tasas guardadas",
          true
        );
      }

      tabs.forEach((tab) =>
        tab.addEventListener("click", () => selectTab(tab.dataset.currency))
      );
      fromInput.addEventListener("input", onFromInput);
      toInput.addEventListener("input", onToInput);
      fromInput.addEventListener("paste", handleNativePaste(fromInput, false));
      toInput.addEventListener("paste", handleNativePaste(toInput, true));
      document.getElementById("swap-btn").addEventListener("click", swap);
      pasteFromBtn.addEventListener("click", handlePasteFrom);
      pasteToBtn.addEventListener("click", handlePasteTo);
      copyBtn.addEventListener("click", handleCopy);

      init();
    </script>
  </body>
</html>
